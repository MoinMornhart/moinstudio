{
  "manifestVersion": 5,
  "id": "de.moinmornhart.moinstudio.bridge",
  "name": "MoinStudio Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "moinstudio-bridge-panel",
      "label": { "default": "MoinStudio" },
      "minimumSize": { "width": 230, "height": 120 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 160 },
      "preferredFloatingSize": { "width": 300, "height": 160 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://127.0.0.1:47811", "ws://localhost:47811"] },
    "localFileSystem": "fullAccess"
  }
}
