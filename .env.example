# MoinStudio – Beispiel für lokale Einstellungen.
# Kopiere diese Datei nach `.env` (wird nie committet).
# WICHTIG: Hier gehört KEIN Anthropic-API-Key hinein. MoinStudio nutzt ausschließlich
# dein Claude-Abo (Claude Desktop per MCP, Claude Code per Abo-Login).

# Datenordner mit Skins, Freunden, Requisiten, Planung, Projekten (z. B. in OneDrive).
# Leer lassen = Auswahl im Einrichtungsassistenten.
MOINSTUDIO_DATA_DIR=

# Adobe-Anbindung nur protokollieren statt ausführen (true/false)
MOINSTUDIO_ADOBE_DRY_RUN=true

# Log-Level: error | warn | info | debug
MOINSTUDIO_LOG_LEVEL=info
