{
  "name": "moinstudio",
  "productName": "MoinStudio",
  "version": "0.19.0",
  "description": "Lokale Desktop-App für Minecraft-Thumbnails, Videoschnitt und Planung mit dem eigenen Claude-Abo",
  "author": "Philip (MoinMornhart)",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/MoinMornhart/moinstudio",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node scripts/electron.mjs .",
    "release": "node scripts/release.mts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "screenshot": "electron-vite build && node scripts/electron.mjs . --moin-screenshot=test-output/screenshots"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.0.0"
  }
}
